digraph DataFlow {
  rankdir=TB;
  bgcolor="#0a0a0f";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, color="#333355", fontcolor="#e0e0e0"];
  edge [fontname="Helvetica", fontsize=8, color="#555577", fontcolor="#888888"];

  /* ── Input Data ── */
  subgraph cluster_input {
    label="Input Data";
    labeljust=l;
    fontcolor="#00d4ff";
    color="#222244";
    style="rounded,dashed";

    cli_opts [label="CLI Options\ngenre, style, instruments\nrecordLabel, producer\nsequential, interactive", fillcolor="#1a1a3e", shape=box];
    sf_index [label="soundfont_index.json\n500 soundfonts\n81,415 presets\n15 MB", fillcolor="#1a1a3e", shape=cylinder];
    genre_defs [label="genre-generator.js\nclassical[] + modern[]\nrandom pairing", fillcolor="#1a1a3e", shape=cylinder];
  }

  /* ── Genre Research Output ── */
  genre_ctx [label="Genre Context Object\n{\n  classical: string,\n  modern: string,\n  creativeName: string,\n  characteristics: { ... },\n  instrumentSuggestions: string[],\n  moodKeywords: string[]\n}", fillcolor="#2a1a1a", shape=box];

  /* ── Drum Arrangement Output ── */
  drum_ctx [label="Drum Context Object\n{\n  drumPattern: string,\n  drumPrograms: number[],\n  velocities: number[],\n  gchordPattern: string\n}", fillcolor="#2a1a1a", shape=box];

  /* ── Soundfont Output ── */
  sf_selection [label="Soundfont Selection\n{\n  soundfonts: string[15-30],\n  categories: {\n    general, drums, bass,\n    strings, synth, specialty\n  },\n  reasoning: string,\n  coverage: { classical, modern, hybrid }\n}", fillcolor="#2a1a1a", shape=box];

  /* ── Composition Output ── */
  comp_structured [label="Structured Composition\n(Output.object)\n{\n  referenceNumber, title, meter,\n  defaultNoteLength, key, tempo,\n  midiExtensions: [\n    { type: 'program', channel, program },\n    { type: 'drum', pattern, programs },\n    { type: 'gchord', instrument }\n  ],\n  voices: [\n    { id, name, clef, midiProgram, notes }\n  ]\n}", fillcolor="#2a2a1e", shape=box];

  abc_text [label="ABC Notation Text\nassembleAbcNotation()\n\nX:1\nT:Fugal 808s\nM:4/4\n%%MIDI program 0 6\n[V:1] CDEF ...\n[V:2] z4 GABG ...", fillcolor="#1a2a1a", shape=note];

  /* ── Validation Output ── */
  valid_result [label="Validation Result\n{\n  isValid: boolean,\n  issues: string[],\n  cleanedNotation: string\n}", fillcolor="#1a2a1a", shape=box];

  /* ── Files Written ── */
  subgraph cluster_files {
    label="Output Files";
    labeljust=l;
    fontcolor="#6b6bff";
    color="#222244";
    style="rounded,dashed";

    abc_file [label=".abc file\nComposition notation", fillcolor="#1a1a2a", shape=note];
    json_file [label=".json metadata\ngenre, soundfonts, options\ncreation timestamp", fillcolor="#1a1a2a", shape=note];
    md_file [label=".md description\nHuman-readable analysis", fillcolor="#1a1a2a", shape=note];
    midi_file [label=".mid file\nabc2midi output", fillcolor="#1a1a2a", shape=note];
    wav_file [label=".wav file\nTiMidity/FluidSynth render", fillcolor="#1a1a2a", shape=note];
    pdf_file [label=".pdf score\nabcm2ps + ghostscript", fillcolor="#1a1a2a", shape=note];
    cfg_file [label=".timidity.cfg\nSoundfont config", fillcolor="#1a1a2a", shape=note];
  }

  /* ── QA Data ── */
  qa_result [label="QA Assessment\n{\n  verdict: pass|fail|needs_revision,\n  scores: { tech, musical, fusion, completeness },\n  issues: {\n    technical: [{ severity, description }],\n    musical: [...],\n    fusion: [...]\n  },\n  recommendations: [\n    { priority, category, action }\n  ]\n}", fillcolor="#2a2a1e", shape=box];

  /* ── Orchestrator State ── */
  orch_state [label="Orchestrator State\n{\n  workHistory: [\n    { agent, reasoning, qaScores }\n  ],\n  currentAbc: string,\n  iteration: number,\n  maxIterations: number\n}", fillcolor="#2a2a1e", shape=box];

  /* ── Session Persistence ── */
  session [label="session.json\n{\n  genre, branches,\n  iterations, qaHistory,\n  humanDirectives,\n  selectedSoundfonts,\n  musicalContext\n}", fillcolor="#3a1a3a", shape=cylinder, color="#ff00ff"];

  /* ── Edges ── */
  cli_opts -> genre_ctx [label="genre string"];
  genre_defs -> genre_ctx [label="random pairing"];
  genre_ctx -> drum_ctx;
  genre_ctx -> sf_selection;
  sf_index -> sf_selection [label="catalog search"];

  genre_ctx -> comp_structured [label="genre context\nin system prompt"];
  drum_ctx -> comp_structured [label="drum directives"];
  sf_selection -> comp_structured [label="soundfont palette\nin system prompt"];

  comp_structured -> abc_text [label="assembleAbcNotation()"];
  abc_text -> valid_result [label="validate"];
  valid_result -> abc_file [label="write if valid"];

  abc_file -> json_file [label="metadata"];
  abc_file -> md_file [label="description agent"];
  abc_file -> midi_file [label="abc2midi"];
  midi_file -> wav_file [label="timidity -c .cfg"];
  abc_file -> pdf_file [label="abcm2ps + gs"];
  sf_selection -> cfg_file [label="generateTimidityConfig()"];
  cfg_file -> wav_file [label="soundfont stack"];

  abc_file -> orch_state [label="--sequential"];
  orch_state -> qa_result [label="after each\niteration"];
  qa_result -> orch_state [label="feedback loop"];
  orch_state -> session [label="persist on\npause/quit"];
  session -> orch_state [label="resume"];
}
