digraph AgentCommunication {
  rankdir=LR;
  bgcolor="#0a0a0f";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, color="#333355", fontcolor="#e0e0e0"];
  edge [fontname="Helvetica", fontsize=8, color="#555577", fontcolor="#888888"];

  /* ── CLI Layer ── */
  subgraph cluster_cli {
    label="CLI Layer";
    labeljust=l;
    fontcolor="#00d4ff";
    color="#222244";
    style="rounded,dashed";

    generate_abc [label="generate-abc.js\nEntry point", fillcolor="#1a1a3e"];
    enhance_comp [label="enhance-composition.js\nOrchestrator entry", fillcolor="#1a1a3e"];
  }

  /* ── Agent Layer ── */
  subgraph cluster_agents {
    label="Agent Layer (AI SDK v6)";
    labeljust=l;
    fontcolor="#ff6b6b";
    color="#222244";
    style="rounded,dashed";

    genre_agent [label="Genre Research\n(Haiku)\nOutput.object()", fillcolor="#2a1a1a"];
    drum_agent [label="Drum Arranger\n(Haiku)\nOutput.object()", fillcolor="#2a1a1a"];
    sf_agent [label="Soundfont Agent\n(Haiku)\nOutput.object()\n3 tools", fillcolor="#2a1a1a"];
    comp_agent [label="Composition Agent\n(Sonnet)\nOutput.object()\n1 tool (validate)", fillcolor="#2a1a1a"];
    desc_agent [label="Description Agent\n(Sonnet)\nOutput.object()", fillcolor="#2a1a1a"];
    orch_agent [label="Orchestrator Agent\n(Sonnet)\nOutput.object()\nRoutes to workers", fillcolor="#2a2a1e"];
    qa_agent [label="QA Agent\n(Sonnet)\nOutput.object()\n4 score dimensions", fillcolor="#2a2a1e"];
  }

  /* ── Worker Agents ── */
  subgraph cluster_workers {
    label="Worker Agents";
    labeljust=l;
    fontcolor="#d4ff00";
    color="#222244";
    style="rounded,dashed";

    comp_worker [label="Composition Worker\naddMoreMusicalContent()", fillcolor="#2a2a1a"];
    orn_worker [label="Ornamentation Worker\naddOrnamentation()", fillcolor="#2a2a1a"];
    midi_worker [label="MIDI Expression Worker\naddMidiExpression()", fillcolor="#2a2a1a"];
  }

  /* ── Tool Layer ── */
  subgraph cluster_tools {
    label="Tool Layer";
    labeljust=l;
    fontcolor="#6bff6b";
    color="#222244";
    style="rounded,dashed";

    validate_tool [label="validateAbcTool\nABC syntax check", fillcolor="#1a2a1a"];
    search_sf [label="searchSoundfontCatalogTool\nKeyword + synonym search\nReturns matched presets", fillcolor="#1a2a1a"];
    detail_sf [label="getSoundfontDetailsTool\nFull preset list\nbank/program/GM name", fillcolor="#1a2a1a"];
    coverage_sf [label="checkProgramCoverageTool\nMIDI program gap analysis", fillcolor="#1a2a1a"];
  }

  /* ── Control Layer ── */
  subgraph cluster_control {
    label="Control Layer (HITL)";
    labeljust=l;
    fontcolor="#ff00ff";
    color="#222244";
    style="rounded,dashed";

    gate_ctrl [label="GateController\nonDecision()\nonAgentOutput()\nonDone()", fillcolor="#3a1a3a"];
    gate_prompts [label="GatePrompts\nReadline UI\n[a] [d] [r] [l] [q]", fillcolor="#3a1a3a"];
    checkpoint [label="CheckpointManager\nSave/restore iterations", fillcolor="#3a1a3a"];
    preview [label="PreviewPlayer\nabc2midi → timidity\nQuick audio preview", fillcolor="#3a1a3a"];
  }

  /* ── Edges: CLI → Agents ── */
  generate_abc -> genre_agent [label="genre string"];
  genre_agent -> drum_agent [label="genre context\nobject"];
  drum_agent -> sf_agent [label="drum info +\ngenre context"];
  sf_agent -> comp_agent [label="soundfont\nselection object"];
  comp_agent -> desc_agent [label="ABC notation", style=dotted, label="parallel"];
  generate_abc -> enhance_comp [label="--sequential\nfoundation ABC"];

  /* ── Edges: Orchestrator ── */
  enhance_comp -> orch_agent [label="ABC + context"];
  orch_agent -> comp_worker [label="invoke\ncomposition"];
  orch_agent -> orn_worker [label="invoke\nornamentation"];
  orch_agent -> midi_worker [label="invoke\nmidi-expression"];
  comp_worker -> qa_agent [label="enhanced ABC"];
  orn_worker -> qa_agent [label="enhanced ABC"];
  midi_worker -> qa_agent [label="enhanced ABC"];
  qa_agent -> orch_agent [label="scores +\nrecommendations"];

  /* ── Edges: Agent → Tools ── */
  comp_agent -> validate_tool [label="tool call", style=dashed];
  sf_agent -> search_sf [label="tool call", style=dashed];
  sf_agent -> detail_sf [label="tool call", style=dashed];
  sf_agent -> coverage_sf [label="tool call", style=dashed];

  /* ── Edges: Control ── */
  orch_agent -> gate_ctrl [label="decision", style=dotted, color="#ff00ff"];
  qa_agent -> gate_ctrl [label="QA result", style=dotted, color="#ff00ff"];
  gate_ctrl -> gate_prompts [label="prompt user"];
  gate_ctrl -> checkpoint [label="save state"];
  gate_ctrl -> preview [label="[l]isten"];
}
